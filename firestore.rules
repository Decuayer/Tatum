rules_version = '2';

// ============================================================================
// TATUM - Development Rules (PERMISSIVE - NOT FOR PRODUCTION!)
// ============================================================================
// WARNING: These rules allow all authenticated users to read/write everything.
// This is for development only. Before production, replace with secure rules.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow all authenticated users to read/write everything
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Also allow some unauthenticated reads for login checks
    match /users/{userId} {
      allow read: if true;
    }
  }
}
